  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId     String?
  leadId         String?
  conversationId String?
  appointmentId  String?

  kind       CustomerSurveyKind      @default(SALES)
  templateId String?
  template   CustomerSurveyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// SMS | EMAIL | LINK | IN_PERSON — channel of capture; SMS does not imply outbound send
  channel String               @default("LINK")
  status  CustomerSurveyStatus @default(DRAFT)

  /// 1–10 when the customer responded — null until RESPONDED
  score   Int?
  comment String?

  /// Manager recovery queue when score is low or complaint language is present
  followUpRequired      Boolean                      @default(false)
  followUpStatus        CustomerSurveyFollowUpStatus @default(NONE)
  assignedManagerUserId String?
  managerNote           String?
  followUpAt            DateTime?

  sentAt          DateTime?
  respondedAt     DateTime?
  createdByUserId String?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, kind, status])
  @@index([tenantId, followUpStatus])
  @@index([tenantId, locationId])
  @@index([leadId])
}

enum CustomerSurveyKind {
  SALES
  SERVICE
}

enum CustomerSurveyFollowUpStatus {
  NONE
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum CustomerSurveyStatus {
  DRAFT
  QUEUED
  SENT
  RESPONDED
  CLOSED
  CANCELLED
}

/// Controlled experiment on customer-facing COPY only (currently: the first greeting).
/// Never varies prices, eligibility, disclosures or consent. Assignment is a stable hash of
/// the conversation key, so a shopper always sees the same variant. A different manager must
/// start it; results never auto-promote a variant.
model Experiment {
  id String @id @default(cuid())

  tenantId    String
  locationId  String?
  key         String
  /// greeting
  surface     String
  /// [{ key, weight, text }] — first entry is the control
  variants    Json
  /// DRAFT | RUNNING | STOPPED
  status      String    @default("DRAFT")
  createdById String?
  startedById String?
  startedAt   DateTime?
  stoppedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

enum WorkflowDefinitionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

/// Staff-authored workflow. The mutable draft lives here; published graphs are immutable WorkflowVersion rows.
model WorkflowDefinition {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// null = tenant-wide; set = rooftop-specific
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  name          String
  status        WorkflowDefinitionStatus @default(DRAFT)
  draftGraph    Json
  /// Highest published version number (0 = never published).
  latestVersion Int                      @default(0)

  createdByUserId           String
  reviewRequestedByUserId   String?
  reviewRequestedAt         DateTime?
  /// Last user to change draftGraph/name; may not approve or deny the review.
  lastEditedByUserId        String?
  /// Set when the draft was produced by a rollback request awaiting review.
  pendingRestoreFromVersion Int?
  /// Every user who changed the draft since the last publish; none may approve or deny it.
  draftContributorUserIds   String[]  @default([])

  versions WorkflowVersion[]
  runs     WorkflowRun[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([tenantId, status])
  @@index([tenantId, locationId])
}

/// Immutable published snapshot. Rollback publishes a NEW version copying an older graph.
model WorkflowVersion {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  version             Int
  graph               Json
  graphChecksum       String
  publishedByUserId   String
  requestedByUserId   String?
  /// Set when this version was produced by rolling back to an earlier version number.
  restoredFromVersion Int?
  note                String?

  createdAt DateTime @default(now())

  @@unique([definitionId, version])
  @@index([tenantId, definitionId])
}

enum WorkflowRunStatus {
  RUNNING
  SUSPENDED
  COMPLETED
  FAILED
  CANCELLED
}

/// A SIMULATION run of a published WorkflowVersion. Persists state per step; no external effects.
/// A run suspended at a human_review node stays suspended until an authorized, independent
/// decision; silence or expiry is never approval.
model WorkflowRun {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?

  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version      Int

  mode           String            @default("SIMULATION")
  status         WorkflowRunStatus @default(RUNNING)
  /// completed | blocked_pending_review | human_approved | human_denied | expired | cancelled | failed
  outcome        String?
  currentNodeId  String?
  /// Query with emails/phones/long digit runs masked; the raw query is never stored.
  queryRedacted  String
  queryLength    Int
  idempotencyKey String?
  /// Reference ids/titles/scores only; never document content.
  references     Json              @default("[]")

  startedByUserId    String
  suspendedAt        DateTime?
  suspendedExpiresAt DateTime?
  decidedByUserId    String?
  decidedAt          DateTime?
  failureReason      String?

  steps WorkflowStepRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, definitionId, idempotencyKey])
  @@index([tenantId, definitionId, createdAt])
  @@index([tenantId, status])
}

model WorkflowStepRun {
  id String @id @default(cuid())

  tenantId String
  runId    String
  run      WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  seq        Int
  nodeId     String
  nodeType   String
  status     String
  durationMs Int
  /// Redacted summary only (counts, ids).
  output     Json?

  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([tenantId, runId])
}

enum ToolActionStatus {
  PENDING_APPROVAL
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
  EXECUTED
  FAILED
}

/// Staff-approved, idempotent, outbox-dispatched tool action. MOCK providers only in this phase.
model ToolActionRequest {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?

  toolName    String
  toolVersion Int
  /// Validated input with free-text fields masked; raw customer text is never stored.
  input       Json
  /// sha256 over tool, version, location and redacted input; approval is bound to this value.
  checksum    String
  /// Opaque reference to the customer consent record, required by consent-gated tools.
  consentRef  String?

  status         ToolActionStatus @default(PENDING_APPROVAL)
  idempotencyKey String?
  expiresAt      DateTime

  requestedByUserId String
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  outboxEventId     String?
  result            Json?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, locationId])
}

// ───────────────────────────── Per-rooftop lead delivery (ADF/XML) — docs/ADF_LEAD_DELIVERY.md

enum LeadDeliveryChannel {
  ADF_EMAIL
}

enum LeadDeliveryDepartment {
  SALES
  SERVICE
  PARTS
}

/// Each state needs its own evidence; they are never collapsed into "success".
enum LeadDeliveryStatus {
  /// Row + outbox event written; nothing handed to any transport yet.
  QUEUED
  /// Handed to the transport (attempt in flight or outcome unknown).
  SENT
  /// Transport/provider acknowledged (e.g. SMTP 250 + message id). NOT delivery, NOT a CRM record.
  ACCEPTED
  /// Provider delivery callback only.
  DELIVERED
  /// Explicit reconciliation input: the CRM parsed the lead.
  CRM_PARSED
  /// Explicit reconciliation input carrying a CRM record reference.
  CRM_MATCHED
  /// Explicit reconciliation input: the CRM parser rejected the lead.
  CRM_REJECTED
  /// Retryable transport failure (outbox backoff owns the retry).
  FAILED
  /// Permanent failure / attempts exhausted / invalid payload. Operator replay only.
  DEAD
  /// A gate was closed (route unknown/unverified/disabled, send disabled, no consent basis…).
  BLOCKED
}

enum LeadDeliveryFormat {
  XML_BODY
  XML_ATTACHMENT
}

enum LeadDeliveryRouteEnvironment {
  SANDBOX
  PRODUCTION
}

/// Server-side destination for one rooftop department. The address is AES-256-GCM encrypted
/// (SecretVaultService); only a keyed fingerprint and a masked display are stored in clear.
/// Never exposed through any public/widget response.
model LeadDeliveryRoute {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  channel     LeadDeliveryChannel          @default(ADF_EMAIL)
  department  LeadDeliveryDepartment
  /// SANDBOX routes may only point at reserved test domains and can never be production-enabled.
  environment LeadDeliveryRouteEnvironment @default(SANDBOX)
  enabled     Boolean                      @default(false)

  destinationCiphertext  String
  destinationIv          String
  destinationAuthTag     String
  /// HMAC-SHA256 (keyed, non-reversible) of the normalized address.
  destinationFingerprint String
  /// e.g. l***@d***.net
  destinationMasked      String

  format     LeadDeliveryFormat @default(XML_BODY)
  adfVersion String             @default("1.0")

  verified             Boolean   @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?
  verificationEvidence String?

  productionEnabled   Boolean   @default(false)
  productionEnabledAt DateTime?
  productionEnabledBy String?

  /// R8: whether THIS destination accepts appointment updates for a lead it already received.
  /// Default NONE (nothing is sent). No dealership has confirmed a protocol yet.
  appointmentUpdates LeadDeliveryAppointmentUpdates @default(NONE)

  deliveries LeadDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationId, channel, department])
  /// Target of the composite FK that makes a cross-tenant delivery→route link impossible.
  @@unique([id, tenantId])
  @@index([tenantId, enabled])
}

/// One row per (lead, channel, destination) attempt chain. Holds no customer contact data and
/// no raw destination address.
model LeadDelivery {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  channel    LeadDeliveryChannel    @default(ADF_EMAIL)
  department LeadDeliveryDepartment

  /// Composite FK (routeId, tenantId) → route (id, tenantId): the route is always the same tenant.
  routeId String?
  route   LeadDeliveryRoute? @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction)

  destinationFingerprint String?
  destinationMasked      String?

  idempotencyKey String

  status       LeadDeliveryStatus @default(QUEUED)
  attempts     Int                @default(0)
  replayCount  Int                @default(0)
  /// 'sandbox' | 'live' — the mode of the most recent transport hand-off (null = never handed off).
  /// A sandbox acknowledgement never counts as acknowledged for a live route.
  deliveryMode String?

  providerName      String?
  providerMessageId String?
  providerRawStatus String?
  crmRecordRef      String?
  payloadSha256     String?
  payloadBytes      Int?

  blockedReason String?
  lastErrorCode String?
  lastErrorAt   DateTime?

  queuedAt      DateTime  @default(now())
  sentAt        DateTime?
  acceptedAt    DateTime?
  deliveredAt   DateTime?
  crmParsedAt   DateTime?
  crmMatchedAt  DateTime?
  crmRejectedAt DateTime?
  failedAt      DateTime?
  deadAt        DateTime?
  blockedAt     DateTime?

  correlationId String
  outboxEventId String?

  events             LeadDeliveryEvent[]
  appointmentUpdates LeadAppointmentUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, locationId, status])
  @@index([leadId])
}

/// R8: per-route capability for appointment updates (proposed policy, default NONE).
enum LeadDeliveryAppointmentUpdates {
  /// Nothing is sent after the lead; the appointment is visible to staff only.
  NONE
  /// A follow-up ADF document carrying the SAME lead reference, to the SAME route.
  ADF_FOLLOW_UP
}

/// R8: the appointment states an update can report. Never collapsed into one another.
enum LeadAppointmentUpdateState {
  REQUESTED
  /// Staff set a time; no scheduling-provider receipt exists.
  SCHEDULED
  /// Backed by a CONFIRMED scheduling-provider receipt.
  CONFIRMED
  CANCELLED
  RESCHEDULED
  FAILED
}

enum LeadAppointmentUpdateStatus {
  /// The destination has no update capability: recorded for staff, nothing queued or sent.
  NOT_SENT
  /// Held until the ORIGINAL lead delivery is accepted. Nothing has been sent.
  WAITING_FOR_LEAD
  QUEUED
  SENT
  /// Transport acknowledged. NOT delivery, NOT a CRM record.
  ACCEPTED
  FAILED
  DEAD
  BLOCKED
}

/// R8: at most one update per (lead, appointment, state) for a lead that already has its
/// LeadDelivery. Holds references and codes only — no address, no customer contact data.
/// It never changes the lead delivery it belongs to.
model LeadAppointmentUpdate {
  id String @id @default(cuid())

  tenantId   String
  locationId String?

  leadId String

  /// The ORIGINAL lead delivery this update follows.
  leadDeliveryId String
  leadDelivery   LeadDelivery @relation(fields: [leadDeliveryId], references: [id], onDelete: Cascade)

  appointmentId String

  state  LeadAppointmentUpdateState
  status LeadAppointmentUpdateStatus

  /// The lead identity the original delivery carried (`amqur-lead-<id>`), repeated verbatim.
  leadRef        String
  /// The CONFIRMED AppointmentProviderReceipt behind a CONFIRMED update (null otherwise).
  receiptId      String?
  /// True when any receipt of the appointment came from a sandbox / demo scheduler.
  sandboxReceipt Boolean @default(false)

  idempotencyKey String

  /// Why nothing was sent (NOT_SENT / WAITING_FOR_LEAD / BLOCKED). A code, never free text.
  reason String?

  routeId                String?
  destinationFingerprint String?
  destinationMasked      String?
  /// 'sandbox' | 'live' — the mode of the most recent hand-off (null = never handed off).
  deliveryMode           String?

  attempts          Int     @default(0)
  providerName      String?
  providerMessageId String?
  providerRawStatus String?
  payloadSha256     String?
  payloadBytes      Int?

  lastErrorCode String?
  lastErrorAt   DateTime?

  sentAt     DateTime?
  acceptedAt DateTime?
  failedAt   DateTime?
  deadAt     DateTime?
  blockedAt  DateTime?

  correlationId String
  outboxEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([leadDeliveryId, createdAt])
  @@index([tenantId, appointmentId])
  @@index([tenantId, leadId, createdAt])
  @@index([status, updatedAt])
}

/// Append-only status history (evidence carries codes/ids only — never PII).
model LeadDeliveryEvent {
  id String @id @default(cuid())

  tenantId   String
  deliveryId String
  delivery   LeadDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  fromStatus LeadDeliveryStatus?
  toStatus   LeadDeliveryStatus
  reasonCode String?
  evidence   Json?
  /// "system" or a staff user id
  actor      String              @default("system")

  createdAt DateTime @default(now())

  @@index([deliveryId, createdAt])
  @@index([tenantId, createdAt])
}

// ───────────────────────────── AMQUR CRM Workforce — docs/CRM_WORKFORCE.md
// Additive, feature-flagged (`crmWorkforce`, default off) and env-gated (CRM_WORKFORCE_ENABLED).
// Nothing in the existing concierge reads or writes these tables.

enum CrmWfControlScope {
  GLOBAL
  TENANT
  LOCATION
  DEPARTMENT
  WORKFLOW
  SALESPERSON
}

enum CrmWfMode {
  OBSERVE
  ASSIST
  SUPERVISED
  CONTROLLED_AUTONOMOUS
}

enum CrmWfDepartment {
  SALES
  SERVICE
  PARTS
}

enum CrmWfTaskStatus {
  PENDING
  CLAIMED
  AWAITING_APPROVAL
  DONE
  SUPPRESSED
  BLOCKED
  ESCALATED
  FAILED
  DEAD
  CANCELLED
}

/// Every one of these is a DIFFERENT state. SENT_UNVERIFIED and UNCERTAIN are never "sent".
enum CrmWfActionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  QUEUED
  EXECUTING
  SENT_UNVERIFIED
  UNCERTAIN
  VERIFIED
  STAFF_CONFIRMED
  BLOCKED
  FAILED
  CANCELLED
}

enum CrmWfSideEffect {
  READ_ONLY
  DRAFT_ONLY
  EXTERNAL
}

/// Kill switches, pauses and operating modes. Evaluated in code, never by a model.
/// The most restrictive row on the path GLOBAL → TENANT → LOCATION → DEPARTMENT → WORKFLOW wins.
model CrmWfControl {
  id String @id @default(cuid())

  scope      CrmWfControlScope
  /// NULL only for the GLOBAL row.
  tenantId   String?
  locationId String?
  department CrmWfDepartment?
  /// Workflow key (WORKFLOW scope) or CRM salesperson name (SALESPERSON scope).
  subjectKey String?
  /// Canonical identity of the scope; one row per scope.
  scopeKey   String            @unique

  halted              Boolean    @default(false)
  /// NULL = this row has no opinion (e.g. a row that only carries a kill switch). A rooftop
  /// with no LOCATION row, or a LOCATION row with NULL here, is OBSERVE.
  mode                CrmWfMode?
  /// External customer sending. NULL = no opinion; the LOCATION row must say true explicitly,
  /// and the env master switch must be on. Starts off everywhere.
  externalSendEnabled Boolean?
  /// CONTROLLED_AUTONOMOUS authorization: workflow, audience, channel, limits, window, signer, document ref.
  authorization       Json?
  reason              String?
  updatedByUserId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, locationId])
}

/// Dealership virtual-representative identity. Never an employee's name; always disclosed as virtual.
model CrmWfAgentProfile {
  id String @id @default(cuid())

  tenantId   String
  locationId String
  department CrmWfDepartment

  displayName String
  title       String
  /// Disclosure line used when the agent first identifies itself.
  disclosure  String
  active      Boolean @default(true)
  version     Int     @default(1)

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, locationId, department])
}

/// One CRM connection per rooftop and adapter. `enabled` needs a recorded authorization.
model CrmWfConnector {
  id String @id @default(cuid())

  tenantId   String
  locationId String
  /// fixture | export_import | manual_assist | tekion_api | tekion_browser
  adapterKey String

  enabled            Boolean   @default(false)
  /// DISABLED | BLOCKED | READY | DEGRADED | DISCONNECTED | SESSION_EXPIRED
  status             String    @default("DISABLED")
  statusReason       String?
  /// Reference to the written authorization (document id / ticket), never the document itself.
  authorizationRef   String?
  authorizedAt       DateTime?
  authorizedByUserId String?
  lastHealthAt       DateTime?
  lastSyncAt         DateTime?
  lastError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationId, adapterKey])
}

/// Read mirror of one CRM lead as returned by an adapter. The CRM stays the system of record.
model CrmWfLead {
  id String @id @default(cuid())

  tenantId   String
  locationId String

  adapterKey     String
  /// The CRM's own id for the lead.
  sourceRecordId String
  asOf           DateTime
  /// True only when the adapter read it from the authoritative CRM. Fixtures are never verified.
  verified       Boolean  @default(false)
  synthetic      Boolean  @default(false)

  department CrmWfDepartment @default(SALES)

  firstName         String?
  /// AES-256-GCM sealed (CrmWfVaultService). Plain contact data is never stored.
  lastNameEnc       String?
  phoneEnc          String?
  emailEnc          String?
  /// Keyed HMAC of the normalized endpoint — lookup and duplicate detection without plaintext.
  phoneHash         String?
  emailHash         String?
  /// Last four digits, for staff to recognise a record without revealing the number.
  phoneLast4        String?
  /// Another mirror row at this rooftop with the same phone or email (oldest wins).
  duplicateOfId     String?
  /// Import batch that created this row / last changed it (export_import adapter).
  importBatchId     String?
  lastImportBatchId String?
  language          String?

  leadSource      String?
  crmStatus       String?
  /// CRM owner (salesperson / BDC rep) — ownership is never removed by the workforce.
  assignedTo      String?
  vehicleInterest Json?

  createdInCrmAt    DateTime?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  hasFutureFollowUp Boolean   @default(false)
  /// NONE | PROPOSED | SCHEDULED | MISSED | SHOWN | CANCELLED — as reported by the CRM.
  appointmentState  String    @default("NONE")
  appointmentAt     DateTime?
  visitedAt         DateTime?

  /// CRM communication preference; NULL = the adapter could not read it.
  crmDoNotContact Boolean?

  /// A human is actively working the conversation until this instant.
  humanActiveUntil DateTime?
  /// Human takeover / per-lead pause. True = no autonomous work on this lead.
  agentPaused      Boolean   @default(false)
  pausedReason     String?
  pausedByUserId   String?

  /// AMQUR Lead matched to this CRM record, when known.
  linkedLeadId      String?
  /// Hash of the fields + history last analysed; unchanged leads are not re-processed.
  contentHash       String?
  lastProcessedHash String?
  lastProcessedAt   DateTime?

  messages CrmWfMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, adapterKey, sourceRecordId])
  @@index([tenantId, locationId, department])
  @@index([tenantId, phoneHash])
  @@index([tenantId, emailHash])
  @@index([tenantId, importBatchId])
}

/// Communication history mirror (one conversation per customer and dealership).
model CrmWfMessage {
  id String @id @default(cuid())

  tenantId  String
  crmLeadId String
  crmLead   CrmWfLead @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)

  /// INBOUND | OUTBOUND
  direction      String
  /// SMS | EMAIL | CALL | CHAT | NOTE
  channel        String
  /// CUSTOMER | STAFF | AGENT | SYSTEM
  authorType     String
  /// Sealed message text (customer words are personal data).
  bodyEnc        String
  importBatchId  String?
  sourceRecordId String
  occurredAt     DateTime

  createdAt DateTime @default(now())

  @@unique([crmLeadId, sourceRecordId])
  @@index([crmLeadId, occurredAt])
}

/// Durable priority work item. Claimed with FOR UPDATE SKIP LOCKED + lease, like the outbox.
model CrmWfTask {
  id String @id @default(cuid())

  tenantId   String
  locationId String
  crmLeadId  String
  department CrmWfDepartment

  /// sales_bdc | service_bdc | parts_bdc | lead_recovery | conversation_manager | appointment_manager
  agentKey    String
  /// e.g. reply_inbound | first_response | appointment_followup | recovery_reactivation
  workflowKey String
  /// 0 (P0 active reply) … 7 (P7 older-lead reactivation)
  priority    Int
  /// Why this priority: rule ids + the facts they read.
  evidence    Json

  status        CrmWfTaskStatus @default(PENDING)
  statusReason  String?
  /// One open task per lead + workflow + content version.
  dedupeKey     String
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastError     String?

  claimedAt        DateTime?
  claimedBy        String?
  leaseExpiresAt   DateTime?
  handlerStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([status, priority, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([tenantId, locationId, status])
  @@index([crmLeadId])
}

/// Typed CRM action ledger: every read, draft and external write, with its compliance decision
/// and the independent verification of its result.
model CrmWfAction {
  id String @id @default(cuid())

  tenantId   String
  locationId String
  crmLeadId  String?
  taskId     String?
  department CrmWfDepartment?

  /// crm.lead.read | message.sms.draft | message.sms.send | crm.note.add | crm.task.create | appointment.propose | escalate …
  actionType String
  sideEffect CrmWfSideEffect
  adapterKey String?
  /// SMS | EMAIL — only for message actions.
  channel    String?

  /// Customer-facing text or structured input (staff-only; redacted before any log).
  payload            Json
  status             CrmWfActionStatus @default(DRAFT)
  statusReason       String?
  /// Full deterministic policy decision captured at draft time and again at execution time.
  complianceDecision Json?
  /// Adapter receipt + the independent read-back that proves (or fails to prove) the write.
  verification       Json?
  externalRef        String?

  idempotencyKey   String
  playbookKey      String?
  playbookVersion  Int?
  approvedByUserId String?
  approvedAt       DateTime?
  executedAt       DateTime?
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, status, createdAt])
  @@index([crmLeadId, createdAt])
}

/// Cross-workflow suppression (STOP, unsubscribe, wrong number, do-not-contact, complaint).
/// channel = ALL blocks every channel; an opt-out is never worked around on another channel.
model CrmWfSuppression {
  id String @id @default(cuid())

  tenantId     String
  /// SMS | EMAIL | CALL | ALL
  channel      String
  /// Keyed HMAC of the normalized endpoint. Survives customer deletion: a suppression must
  /// keep working after the contact data itself is erased.
  endpointHash String
  /// Masked hint for staff ("…0142", "s…@example.com").
  hint         String
  /// STOP | UNSUBSCRIBE | WRONG_NUMBER | DO_NOT_CONTACT | COMPLAINT | CUSTOMER_REQUEST | MANUAL
  reason       String
  /// INBOUND_MESSAGE | CRM_PREFERENCE | STAFF | IMPORT
  source       String

  crmLeadId       String?
  createdByUserId String?
  liftedAt        DateTime?
  liftedByUserId  String?

  createdAt DateTime @default(now())

  @@index([tenantId, endpointHash])
  @@index([tenantId, createdAt])
}

/// Persisted model/infrastructure cost ledger for the workforce.
model CrmWfUsage {
  id String @id @default(cuid())

  tenantId     String
  locationId   String?
  taskId       String?
  crmLeadId    String?
  /// llm.draft | llm.classify | deterministic
  kind         String
  provider     String?
  model        String?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costMicroUsd Int     @default(0)
  cached       Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Worker liveness. A stale heartbeat shows the worker as DOWN in the Command Center.
model CrmWfHeartbeat {
  id String @id @default(cuid())

  workerId   String   @unique
  role       String
  /// RUNNING | IDLE_DISABLED | HALTED | STOPPING
  state      String
  detail     Json?
  startedAt  DateTime @default(now())
  lastBeatAt DateTime @default(now())
}

/// Manager review of an agent draft; the sanitized basis for evaluation and improvement.
model CrmWfReview {
  id String @id @default(cuid())

  tenantId       String
  locationId     String
  actionId       String
  /// 1–5
  score          Int
  /// good | too_long | wrong_fact | wrong_tone | should_escalate | compliance | other
  label          String
  /// Staff's corrected text with contact details masked.
  correctedBody  String?
  note           String?
  reviewerUserId String

  createdAt DateTime @default(now())

  @@index([tenantId, locationId, createdAt])
  @@index([actionId])
}

/// Business outcome. OBSERVED = seen in the CRM; ATTRIBUTED = credited to workforce activity.
/// A CRM deal record is DEAL_CREATED, never SALE_VERIFIED.
model CrmWfOutcome {
  id String @id @default(cuid())

  tenantId       String
  locationId     String
  crmLeadId      String
  department     CrmWfDepartment
  /// CUSTOMER_REPLIED | QUALIFIED | APPT_SET | APPT_CONFIRMED | APPT_SHOWN | DEAL_CREATED | SALE_VERIFIED | SERVICE_APPT_VERIFIED | RECOVERED | OPT_OUT | COMPLAINT
  kind           String
  /// OBSERVED | ATTRIBUTED
  basis          String
  sourceRecordId String
  verified       Boolean         @default(false)
  occurredAt     DateTime

  createdAt DateTime @default(now())

  @@unique([tenantId, crmLeadId, kind, sourceRecordId])
  @@index([tenantId, locationId, kind, occurredAt])
}

/// One uploaded CRM export. PREVIEWED → COMMITTED → ROLLED_BACK. The file itself is never
/// stored — only its hash, the column mapping and the validation report.
model CrmWfImportBatch {
  id String @id @default(cuid())

  tenantId   String
  locationId String

  /// PREVIEWED | COMMITTED | ROLLED_BACK | REJECTED
  status     String   @default("PREVIEWED")
  fileName   String?
  fileSha256 String
  exportedAt DateTime
  /// True when every contact in the file is a reserved test value (555-01xx / .invalid etc.).
  synthetic  Boolean  @default(false)
  /// field → source column actually used.
  mapping    Json
  /// { rows, created, updated, unchanged, duplicates, rejected, suppressed, tasksQueued }
  counts     Json
  /// Rejected rows + ignored columns + warnings. Row numbers and reasons only, no cell values.
  validation Json

  authorizationRef   String?
  createdByUserId    String
  committedAt        DateTime?
  rolledBackAt       DateTime?
  rolledBackByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, locationId, createdAt])
}

/// What a committed batch did to one mirror row, so the batch can be rolled back exactly.
model CrmWfImportChange {
  id String @id @default(cuid())

  tenantId  String
  batchId   String
  crmLeadId String
  /// CREATED | UPDATED
  kind      String
  /// For UPDATED: the row's previous column values (contact fields are still sealed).
  before    Json?

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([tenantId, crmLeadId])
}

/// An internal request for a person to act in the CRM (appointment, note, follow-up,
/// escalation, buyer alert). It is NEVER a CRM record itself: OPEN means "asked", and
/// STAFF_CONFIRMED means an employee says they did it — only CRM_VERIFIED is a read-back.
model CrmWfWorkItem {
  id String @id @default(cuid())

  tenantId   String
  locationId String
  crmLeadId  String?
  department CrmWfDepartment

  /// APPOINTMENT_REQUEST | APPOINTMENT_RESCHEDULE | APPOINTMENT_CANCEL | APPOINTMENT_CONFIRM |
  /// CRM_NOTE | FOLLOW_UP | ESCALATION | QUALIFIED_BUYER | SERVICE_REQUEST | PARTS_INQUIRY
  kind             String
  /// OPEN | IN_PROGRESS | STAFF_CONFIRMED | CRM_VERIFIED | DECLINED | CANCELLED
  status           String    @default("OPEN")
  /// LOW | NORMAL | HIGH | CRITICAL
  urgency          String    @default("NORMAL")
  title            String
  /// Structured request (requested time, note text, instruction). Free text is redacted of
  /// contact details before it is stored.
  payload          Json
  dueAt            DateTime?
  /// CRM owner name the item is for, and/or the staff user who picked it up.
  assigneeName     String?
  assignedUserId   String?
  /// Who asked: "agent:<key>" or a staff user id.
  createdBy        String
  /// What the employee recorded when closing it (e.g. the CRM appointment reference).
  resolution       Json?
  resolvedByUserId String?
  resolvedAt       DateTime?
  dedupeKey        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, locationId, status, kind])
  @@index([crmLeadId])
}

/// One-time link for a staff member to set their own password: an invitation or an
/// administrator-issued reset. Only a SHA-256 of the token is stored; the token itself is
/// shown once to the administrator who created it. Single use, short-lived.
model CrmWfStaffToken {
  id String @id @default(cuid())

  tenantId String
  userId   String
  /// INVITE | RESET
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdByUserId String

  createdAt DateTime @default(now())

  @@index([tenantId, userId])
}
