# Staging pilot environment — placeholders only. Copy to `.env.staging` locally.
# NEVER commit real secrets.

NODE_ENV=production
PORT=3000

# REQUIRED: dedicated STAGING Postgres (do not reuse production)
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/amqur_staging?schema=public

JWT_SECRET=REPLACE_WITH_STAGING_SECRET_AT_LEAST_32_CHARS_LONG
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WIDGET_TOKEN_EXPIRES_IN=4h

# Staging CORS — Dial Auto Group test/staging domains only
CORS_ORIGINS=https://staging.example-dealer.com,http://localhost:5173

BOOTSTRAP_SECRET=

# LLM polish optional on staging
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# CRM / Tekion — MUST remain empty/disabled for pilot
CRM_WEBHOOK_URL=

# Inventory: prefer fixture sync off until authorized feed URL is set
INVENTORY_SYNC_ENABLED=false
INVENTORY_FEED_ALLOWED_HOSTS=

# Secret vault (optional until live credentials exist)
INTEGRATION_ENCRYPTION_KEY=

# Google Calendar — leave empty so appointments stay REQUESTED only
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Per-rooftop ADF/XML lead delivery (docs/ADF_LEAD_DELIVERY.md). Everything is fail-closed.
# Master switch: false = nothing is ever handed to a transport.
ADF_SEND_ENABLED=false
# sandbox | live. `live` only takes effect with NODE_ENV=production + ADF_SEND_ENABLED=true +
# a verified, production-enabled PRODUCTION route. Leave as sandbox.
LEAD_DELIVERY_MODE=sandbox
# Sandbox transport: sink (in-process) | smtp (loopback mock SMTP only).
ADF_SANDBOX_TRANSPORT=sink
ADF_SMTP_HOST=127.0.0.1
ADF_SMTP_PORT=11025
ADF_SMTP_SECURE=false
# ADF_SMTP_USER=
# ADF_SMTP_PASS=
ADF_FROM_ADDRESS=adf-sandbox@amqur.example.invalid
ADF_PROVIDER_NAME=AMQUR AI
ADF_MAX_BYTES=65536
# ADF_SANDBOX_SINK_DIR=
