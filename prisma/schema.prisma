generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Parent dealer group for authorized group-level reporting only.
/// Does NOT grant cross-tenant access to normal tenant admins.
model DealerGroup {
  id   String @id @default(cuid())
  slug String @unique
  name String

  tenants     Tenant[]
  memberships DealerGroupMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DealerGroupRole {
  GROUP_VIEWER
  GROUP_ADMIN
}

/// Explicit membership required for any cross-tenant group reporting.
model DealerGroupMembership {
  id String @id @default(cuid())

  dealerGroupId String
  dealerGroup   DealerGroup @relation(fields: [dealerGroupId], references: [id], onDelete: Cascade)

  /// Platform user id (must also pass auth); membership alone is insufficient without JWT.
  userId String
  role   DealerGroupRole @default(GROUP_VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealerGroupId, userId])
  @@index([userId])
  @@index([dealerGroupId])
}

model Tenant {
  id   String @id @default(cuid())
  slug String @unique
  name String

  dealerGroupId String?
  dealerGroup   DealerGroup? @relation(fields: [dealerGroupId], references: [id], onDelete: SetNull)

  /// Optional comma-separated allowlist of widget origins (e.g. https://dealer.com)
  allowedOrigins String?

  /// JSON map of feature flag overrides for this tenant
  featureFlags Json?

  /// Public-safe branding + copy for widget (never secrets).
  /// Shape: assistantDisplayName, welcomeMessage, primaryColor, accentColor, logoUrl,
  /// launcherIconUrl, phone, websiteUrl, privacyUrl, termsUrl, escalationMessage,
  /// disclaimerText, supportedLocales, salesEnabled, serviceEnabled, partsEnabled
  publicConfig Json?

  /// Bumped on branding/config changes for cache invalidation
  configVersion Int @default(1)

  /// Days after LAST ACTIVITY before conversations + messages are HARD-DELETED (not archived).
  dataRetentionDays Int @default(365)
  /// Analytics events older than this are hard-deleted (aggregate-safe, no PII).
  analyticsRetentionDays Int @default(400)
  /// When true, the retention job deletes nothing for this tenant (litigation / regulator hold).
  legalHold Boolean @default(false)

  /// Customer-facing consent text (public-safe)
  consentText String?

  /// Tenant-default FinancialAssumptionPolicy (location overrides merge on top).
  /// Shape: see src/finance/financial-assumption-policy.ts
  financialPolicy Json?

  /// Tenant-default approved credit-application destination (location overrides).
  /// Shape: see src/finance/credit-application.service.ts
  creditApplication Json?

  consentRecords ConsentRecord[]

  locations              Location[]
  users                  User[]
  vehicles               Vehicle[]
  conversations          Conversation[]
  leads                  Lead[]
  appointments           Appointment[]
  escalations            Escalation[]
  auditLogs              AuditLog[]
  integrationConnections IntegrationConnection[]
  sourceAuthorityRules   SourceAuthorityRule[]
  sourceConflicts        SourceConflict[]
  inventoryImportRuns    InventoryImportRun[]
  savedVehicles          SavedVehicle[]
  partsInquiries         PartsInquiry[]
  outboxEvents           OutboxEvent[]
  webhookInboxes         WebhookInbox[]
  followUpCampaigns      FollowUpCampaign[]
  canaryInvites          CanaryInvite[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeSources       KnowledgeSource[]
  tradeRequests          TradeRequest[]
  fileObjects            FileObject[]
  analyticsEvents        AnalyticsEvent[]
  voiceCallSessions      VoiceCallSession[]
  websiteAllowedDomains  WebsiteAllowedDomain[]
  financeRequests        FinanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerGroupId])
}

/// One-time employee canary invite (redeem → HttpOnly signed session cookie).
model CanaryInvite {
  id String @id @default(cuid())

  jti String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId  String
  /// staging | production | test
  environment String

  /// Authorized tester label (email or staff id) — not a secret
  testerLabel String?

  expiresAt  DateTime
  redeemedAt DateTime?
  revokedAt  DateTime?

  createdByUserId String?

  createdAt DateTime @default(now())

  @@index([tenantId, locationId])
  @@index([expiresAt])
}

model Location {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  slug     String
  address  String?
  phone    String?
  timezone String  @default("America/Chicago")

  /// Store hours as JSON: { mon: { open: "09:00", close: "19:00" }, ... }
  /// Only expose to customers when verified/current for this location.
  storeHours Json?

  /// Holiday / one-off closures + overrides: [{ date: "2026-12-25", closed: true } | { date, open, close, note? }]
  holidayHours Json?

  /// Department-specific weekly hours: { service: { mon: {open,close}, ... }, parts: {...}, sales: {...} }
  departmentHours Json?

  /// Who verified hours and when — hours are customer-visible only when verified.
  storeHoursVerifiedAt DateTime?
  storeHoursVerifiedBy String?

  /// Location FinancialAssumptionPolicy override (merged over Tenant.financialPolicy)
  financialPolicy Json?

  /// Location credit-application override (merged over Tenant.creditApplication)
  creditApplication Json?

  /// Verified transportation options for service: { shuttle?: bool, loaner?: bool, rideshare?: bool, verifiedAt }
  serviceAmenities Json?

  inventoryFeedUrl  String?
  inventoryFeedType InventoryFeedType?

  /// Optional provider-specific external IDs (Tekion store id, vAuto feed id, etc.)
  externalIds Json?

  /// Location-level feature flag overrides (merged over tenant)
  featureFlags Json?

  /// Location public branding overrides (merged over tenant.publicConfig)
  publicConfig Json?

  /// Inventory freshness SLA hours (default 24)
  inventoryFreshnessHours Int @default(24)

  /// Minimum records expected from a snapshot feed (anomaly guard)
  inventoryMinRecords Int @default(1)

  /// Escalation recipient emails (comma-separated) — staff-only, never in widget-config
  escalationRecipients String?

  users                  User[]
  vehicles               Vehicle[]               @relation("LocationVehicles")
  conversations          Conversation[]
  leads                  Lead[]
  appointments           Appointment[]
  escalations            Escalation[]
  integrationConnections IntegrationConnection[]
  inventoryImportRuns    InventoryImportRun[]
  savedVehicles          SavedVehicle[]
  partsInquiries         PartsInquiry[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeSources       KnowledgeSource[]
  tradeRequests          TradeRequest[]
  fileObjects            FileObject[]
  analyticsEvents        AnalyticsEvent[]
  voiceCallSessions      VoiceCallSession[]
  websiteAllowedDomains  WebsiteAllowedDomain[]
  financeRequests        FinanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum InventoryFeedType {
  XML
  JSON
  CSV
}

model User {
  id String @id @default(cuid())

  email    String
  password String

  firstName String
  lastName  String

  role Role @default(STAFF)

  /// Disabled users cannot log in or refresh; access tokens age out (<=15m).
  isActive Boolean @default(true)

  /// TOTP MFA (RFC 6238). Secret stored AES-256-GCM encrypted via SecretVault.
  mfaEnabled       Boolean   @default(false)
  mfaSecretEnc     Json?
  mfaPendingSecretEnc Json?
  mfaRecoveryHashes String[] @default([])
  mfaLastCounter   Int?
  mfaEnrolledAt    DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

model Vehicle {
  id String @id @default(cuid())

  tenantId   String
  locationId String?

  vin   String
  stock String?

  year  Int
  make  String
  model String
  trim  String?

  bodyType      String?
  drivetrain    String?
  transmission  String?
  fuelType      String?
  color         String?
  interiorColor String?

  price   Int?
  msrp    Int?
  mileage Int?

  photos   Json?
  features Json?

  /// new | used | certified | unknown — merchandising condition when supplied by feed
  condition String?

  status VehicleStatus @default(AVAILABLE)

  /// Provenance: feed source identifier (e.g. vauto_feed, tekion_dms)
  source     String?
  lastSeenAt DateTime?

  /// Derived freshness for customer-facing disclosure
  freshnessState InventoryFreshnessState @default(UNAVAILABLE)

  /// Last successful import run that touched this vehicle
  importRunId String?

  /// Provider source timestamp when available from feed
  sourceTimestamp DateTime?

  /// Raw provider payload snippet for audit (minimized)
  rawSource Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation("LocationVehicles", fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, vin])
  @@index([tenantId, status])
  @@index([tenantId, make, model])
  @@index([tenantId, price])
  @@index([tenantId, freshnessState])
  @@index([locationId])
  @@index([stock])
}

enum InventoryFreshnessState {
  FRESH
  DEGRADED
  STALE
  UNAVAILABLE
}

enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  HOLD
  MISSING
  SOLD
}

model Conversation {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// Widget conversationId or staff user id
  externalKey String

  channel ConversationChannel @default(WIDGET)

  /// Serialized ConversationInventoryState
  state Json @default("{}")

  /// Optimistic-concurrency counter for state writes across API replicas
  stateVersion Int @default(0)

  /// Handoff lifecycle: AI | REQUESTED | QUEUED | ASSIGNED | JOINED | RELEASED
  handoffState   String  @default("AI")
  /// When true the AI must not send autonomous customer replies (staff owns the thread)
  aiPaused       Boolean @default(false)
  assignedUserId String?

  /// Customer language preference (BCP-47 short code, e.g. en, es)
  language String?

  messages     Message[]
  leads        Lead[]
  appointments Appointment[]
  escalations  Escalation[]

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, externalKey])
  @@index([tenantId, lastActivityAt])
}

enum ConversationChannel {
  WIDGET
  STAFF
  SMS
  EMAIL
  WHATSAPP
  MESSENGER
  INSTAGRAM
  VOICE
  GOOGLE_BUSINESS
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  /// Optional structured payload (vehicle cards, payment, etc.)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Lead {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  firstName String?
  lastName  String?
  phone     String?
  email     String?
  zipCode   String?

  interestedVin   String?
  interestedStock String?

  budget             Int?
  desiredPayment     Int?
  financingNeeded    Boolean?
  preferredContact   String?
  languagePreference String?
  purchaseTimeline   String?
  tradeInInterest    Boolean?
  leaseVsPurchase    String?
  consentToText      Boolean   @default(false)
  consentToEmail     Boolean   @default(false)
  consentToCall      Boolean   @default(false)
  optOutAt           DateTime?

  /// Transparent score reason codes + rule version
  scoreReasons Json?
  scoreVersion String?

  /// Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// External CRM identity after successful writeback (Tekion customer/lead id)
  externalCrmCustomerId String?
  externalCrmLeadId     String?
  crmSyncStatus         CrmSyncStatus @default(NONE)
  crmLastSyncedAt       DateTime?
  crmLastError          String?

  source String     @default("widget")
  score  Int        @default(0)
  stage  LeadStage  @default(COLD)
  status LeadStatus @default(OPEN)

  assignedUserId String?
  notes          String?
  nextBestAction String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, externalCrmLeadId])
  @@index([conversationId])
}

enum CrmSyncStatus {
  NONE
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum LeadStage {
  COLD
  WARM
  HOT
}

enum LeadStatus {
  OPEN
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
  SPAM
}

model Appointment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  type AppointmentType @default(SALES)

  /// Customer-requested date (YYYY-MM-DD) — not confirmed availability unless status=CONFIRMED
  requestedDate String?
  requestedTime String?

  /// Verified slot when available from calendar integration
  scheduledAt DateTime?

  status AppointmentStatus @default(REQUESTED)

  customerName  String?
  customerPhone String?
  customerEmail String?

  vehicleVin String?
  notes      String?

  /// False until a human or verified calendar confirms the slot
  availabilityVerified Boolean @default(false)

  leadId          String?
  /// IANA timezone the requested/scheduled time is expressed in (dealership tz)
  timezone        String    @default("America/Chicago")
  /// Customer's raw phrase, e.g. "Saturday at 3"
  requestedPhrase String?
  /// Requested instant computed in dealership timezone (UTC storage)
  requestedAt     DateTime?
  serviceType     String?
  transportation  String?

  /// Scheduling provider that owns confirmation (NONE = AMQUR request only)
  provider           String  @default("NONE")
  externalProviderId String?
  providerStatus     String?
  /// Structured provenance: { source, recordedBy, confirmedBy, providerRequestId, ... }
  provenance         Json?
  idempotencyKey     String?

  rescheduledFromId String?
  confirmedAt       DateTime?
  canceledAt        DateTime?
  cancelReason      String?
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, locationId, requestedAt])
  @@index([conversationId])
}

enum AppointmentType {
  SALES
  SERVICE
  PARTS
  FINANCE
  TEST_DRIVE
}

enum AppointmentStatus {
  REQUESTED
  PENDING_CONFIRMATION
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Escalation {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  reason   String
  urgency  EscalationUrgency @default(NORMAL)
  status   EscalationStatus  @default(OPEN)
  summary  String?
  metadata Json?

  notifiedAt DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([conversationId])
}

enum EscalationUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hash of the raw refresh token
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
}

/// Provider connection config per tenant/location (Tekion, vAuto, messaging, etc.)
model IntegrationConnection {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  provider   IntegrationProvider
  /// Logical capability set: crm | dms | inventory_feed | appointments | messaging | voice
  capability String

  enabled   Boolean @default(false)
  /// Live credentials + partner docs required before enabling
  liveReady Boolean @default(false)

  /// Non-secret config (base URL placeholder, API version, dealer mapping ids)
  config Json @default("{}")

  healthStatus     IntegrationHealthStatus @default(UNKNOWN)
  lastHealthAt     DateTime?
  lastSuccessAt    DateTime?
  lastError        String?
  circuitOpenUntil DateTime?

  /// Sync cursor for incremental reconciliation
  syncCursor String?

  secrets IntegrationSecret[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationId, provider, capability])
  @@index([tenantId, provider])
  @@index([tenantId, enabled])
}

enum IntegrationProvider {
  TEKION
  VAUTO
  TWILIO
  GOOGLE_CALENDAR
  GENERIC_WEBHOOK
  MOCK
  NORMALIZED_INVENTORY_HTTP
  OPENAI
  WEBSITE_CONTENT
}

enum IntegrationHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
  DISABLED
}

/// Encrypted secret material for an integration connection
model IntegrationSecret {
  id String @id @default(cuid())

  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  keyName    String
  /// AES-256-GCM ciphertext (base64) — never log plaintext
  ciphertext String
  iv         String
  authTag    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, keyName])
}

/// Field-level source-of-truth rules
model SourceAuthorityRule {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  field             String
  primarySource     String
  fallbackSource    String?
  freshnessSlaHours Int     @default(24)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, field])
  @@index([tenantId])
}

model SourceConflict {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  field             String
  entityType        String
  entityId          String
  primaryValue      String?
  conflictingValue  String?
  primarySource     String
  conflictingSource String
  status            SourceConflictStatus @default(OPEN)
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
}

enum SourceConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

model InventoryImportRun {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  provider  IntegrationProvider @default(VAUTO)
  transport String?
  format    String?

  status InventoryImportStatus @default(PENDING)

  sourceIdentifier String?
  checksum         String?
  recordCount      Int?
  validCount       Int?
  rejectedCount    Int?
  anomalyFlags     Json?

  rawArtifactPath String?
  errorMessage    String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([tenantId, startedAt])
  @@index([locationId, startedAt])
  @@index([status])
}

enum InventoryImportStatus {
  PENDING
  DOWNLOADED
  VALIDATING
  STAGED
  RECONCILING
  SUCCEEDED
  FAILED
  REJECTED_ANOMALY
}

model SavedVehicle {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  conversationExternalKey String
  vin                     String

  alertPriceDrop   Boolean @default(false)
  alertBackInStock Boolean @default(false)
  consentOutbound  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, conversationExternalKey, vin])
  @@index([tenantId, vin])
}

model PartsInquiry {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  conversationId       String?
  vin                  String?
  partDescription      String
  status               PartsInquiryStatus @default(REQUESTED)
  fitmentVerified      Boolean            @default(false)
  availabilityVerified Boolean            @default(false)
  priceVerified        Boolean            @default(false)
  notes                String?
  customerName         String?
  customerPhone        String?
  customerEmail        String?

  partNumber            String?
  /// Customer-described / suspected part — NOT a verified catalog match
  suspectedPart         String?
  vehicleYear           Int?
  vehicleMake           String?
  vehicleModel          String?
  /// Authoritative fitment source (provider id) when fitmentVerified=true
  fitmentSource         String?
  etaVerified           Boolean @default(false)
  providerReference     String?
  /// INFO | QUOTE | RESERVE | ORDER | INSTALL
  preferredAction       String?
  installationRequested Boolean @default(false)
  installAppointmentId  String?
  provenance            Json?
  idempotencyKey        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([conversationId])
}

enum PartsInquiryStatus {
  REQUESTED
  PENDING_STAFF
  FITMENT_PENDING
  QUOTED
  ORDERED
  CLOSED
  CANCELLED
}

/// Transactional outbox for reliable async side-effects
model OutboxEvent {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  topic          String
  payload        Json
  idempotencyKey String?

  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  publishedAt   DateTime?

  /// Lease for multi-worker safe claiming (FOR UPDATE SKIP LOCKED)
  claimedAt      DateTime?
  claimedBy      String?
  leaseExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([tenantId, topic])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD
}

/// Inbound webhooks with replay protection
model WebhookInbox {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider        IntegrationProvider
  externalEventId String
  signatureValid  Boolean             @default(false)
  payload         Json
  status          WebhookInboxStatus  @default(RECEIVED)
  processedAt     DateTime?
  errorMessage    String?

  createdAt DateTime @default(now())

  @@unique([tenantId, provider, externalEventId])
  @@index([status, createdAt])
}

enum WebhookInboxStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
  REJECTED
}

model FollowUpCampaign {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  trigger  String
  channel  String
  enabled  Boolean @default(false)
  /// Quiet hours, caps, stop conditions as JSON
  policy   Json    @default("{}")
  template String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
}

/// Approved knowledge source registry (manual, upload, website, policy, FAQ).
model KnowledgeSource {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  sourceType     KnowledgeSourceType
  title          String
  canonicalUrl   String?
  authorityLevel KnowledgeAuthorityLevel @default(UNVERIFIED)
  status         KnowledgeStatus         @default(DRAFT)
  metadata       Json?

  documents KnowledgeDocument[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([tenantId, status])
  @@index([tenantId, locationId])
}

enum KnowledgeSourceType {
  MANUAL_ARTICLE
  UPLOADED_DOCUMENT
  VERIFIED_WEBSITE
  DEALERSHIP_POLICY
  OEM_INFORMATION
  SERVICE_FAQ
  FINANCE_FAQ
  PARTS_FAQ
  HOURS_CONTACT
  PROMOTION
  INTERNAL_SOP
}

enum KnowledgeAuthorityLevel {
  UNVERIFIED
  REVIEWED
  APPROVED
  AUTHORITATIVE
}

enum KnowledgeStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  EXPIRED
  ARCHIVED
  REJECTED
}

model KnowledgeDocument {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  sourceId String?
  source   KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  title            String
  canonicalUrl     String?
  content          String
  contentChecksum  String
  version          Int                 @default(1)
  status           KnowledgeStatus     @default(DRAFT)
  visibility       KnowledgeVisibility @default(CUSTOMER)
  effectiveAt      DateTime?
  expiresAt        DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  lastVerifiedAt   DateTime?
  metadata         Json?

  chunks KnowledgeChunk[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([tenantId, status, visibility])
  @@index([tenantId, locationId])
  @@index([tenantId, contentChecksum])
}

enum KnowledgeVisibility {
  CUSTOMER
  STAFF
  INTERNAL
}

model KnowledgeChunk {
  id String @id @default(cuid())

  tenantId   String
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  locationId     String?
  chunkIndex     Int
  content        String
  /// Optional embedding vector stored as JSON float array (provider-agnostic).
  /// Prefer pgvector migration later when extension is available in all envs.
  embedding      Json?
  embeddingModel String?
  tokenCount     Int?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, chunkIndex])
  @@index([tenantId, locationId])
  @@index([tenantId, documentId])
}

/// Allowlisted domains for controlled website ingestion (never arbitrary crawl).
model WebsiteAllowedDomain {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  hostname         String
  pathPrefix       String?
  enabled          Boolean @default(true)
  requiresApproval Boolean @default(true)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, hostname])
  @@index([tenantId, enabled])
}

model TradeRequest {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  conversationId    String?
  vin               String?
  year              Int?
  make              String?
  model             String?
  trim              String?
  mileage           Int?
  condition         String?
  payoffAmount      Float?
  ownership         String?
  desiredVehicleVin String?
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  notes             String?
  /// Never invent appraisal — verified only when TradeProvider confirms.
  appraisalVerified Boolean            @default(false)
  appraisalValue    Float?
  status            TradeRequestStatus @default(REQUESTED)
  photoFileIds      String[]           @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, conversationId])
}

enum TradeRequestStatus {
  REQUESTED
  PENDING_STAFF
  APPRAISAL_PENDING
  QUOTED
  ACCEPTED
  DECLINED
  CLOSED
  CANCELLED
}

model FinanceRequest {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  conversationId  String?
  vehicleVin      String?
  desiredPayment  Float?
  downPayment     Float?
  termMonths      Int?
  leaseOrPurchase String?
  tradeInterest   Boolean              @default(false)
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  /// APR never invented — only stored when customer-provided or verified config.
  aprProvided     Float?
  /// CUSTOMER | NONE — dealer/lender APR is never stored here without a verified provider
  aprSource       String               @default("NONE")
  status          FinanceRequestStatus @default(REQUESTED)
  notes           String?

  /// NONE | OFFERED | DISPLAYED | CLICKED | RETURNED | COMPLETED_VERIFIED
  creditLinkState     String    @default("NONE")
  creditLinkOfferedAt DateTime?
  creditLinkClickedAt DateTime?
  /// NONE | REQUESTED | QUEUED | ASSIGNED
  handoffState        String    @default("NONE")
  provenance          Json?
  idempotencyKey      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([conversationId])
}

enum FinanceRequestStatus {
  REQUESTED
  PENDING_STAFF
  ESTIMATE_SHARED
  HANDED_OFF
  CLOSED
  CANCELLED
}

/// Tenant-scoped upload metadata (binaries in object storage / local disk — not Postgres BLOBs).
model FileObject {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  storageKey       String
  originalName     String
  mimeType         String
  byteSize         Int
  checksumSha256   String
  purpose          FilePurpose
  scannedStatus    FileScanStatus @default(PENDING)
  uploadedByUserId String?
  conversationId   String?
  metadata         Json?
  deletedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, storageKey])
  @@index([tenantId, purpose])
  @@index([tenantId, conversationId])
}

enum FilePurpose {
  TRADE_PHOTO
  SERVICE_PHOTO
  DOCUMENT
  KNOWLEDGE_UPLOAD
  OTHER
}

enum FileScanStatus {
  PENDING
  CLEAN
  REJECTED
  SKIPPED
  ERROR
}

model AnalyticsEvent {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  eventType               String
  /// Aggregate-safe properties only — no raw PII/secrets.
  properties              Json?
  conversationExternalKey String?
  occurredAt              DateTime @default(now())

  @@index([tenantId, eventType, occurredAt])
  @@index([tenantId, locationId, occurredAt])
}

/// Voice-ready call session state (provider-disabled until credentials exist).
model VoiceCallSession {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  externalCallId          String
  direction               String
  state                   String
  fromNumber              String?
  toNumber                String?
  recordingConsent        Boolean   @default(false)
  language                String?
  conversationExternalKey String?
  leadId                  String?
  escalationId            String?
  summary                 String?
  metadata                Json?
  endedAt                 DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, externalCallId])
  @@index([tenantId, state])
}

/// Per-channel, per-purpose consent ledger. Never collapse SMS/email/call/WhatsApp into one boolean.
model ConsentRecord {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId              String?
  leadId                  String?
  conversationExternalKey String?

  /// SMS | EMAIL | CALL | WHATSAPP
  channel        String
  /// Normalized endpoint (E.164 phone / lowercased email) — PII, staff-only
  endpoint       String
  /// TRANSACTIONAL | CONVERSATIONAL | MARKETING
  purpose        String
  granted        Boolean
  /// Exact wording + version shown to the customer
  wording        String?
  wordingVersion String?
  /// WIDGET | STAFF | SMS_KEYWORD | PROVIDER | IMPORT
  source         String
  evidence       Json?
  revokedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, channel, endpoint, createdAt])
  @@index([tenantId, leadId])
}
