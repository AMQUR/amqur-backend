  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum PlaybookDepartment {
  GENERAL
  SALES
  SERVICE
  PARTS
  FINANCE
}

model ConversationPlaybook {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// Uniqueness helper: locationId or "_" for tenant-wide (Postgres NULL ≠ NULL in unique indexes).
  locationScope String @default("_")

  /// Stable key within tenant+location (e.g. "sales-first-response")
  key        String
  title      String
  department PlaybookDepartment @default(GENERAL)
  status     PlaybookStatus     @default(DRAFT)
  version    Int                @default(1)

  /// Tone: casual | professional | concise | friendly | premium
  tone         String  @default("concise")
  /// Target reply length hint for compose (does not override safety/detail exceptions)
  brevity      String  @default("short")
  /// Optional daypart/rapport allowance for this playbook only
  allowRapport Boolean @default(false)
  oneQuestion  Boolean @default(true)

  /// Approved greetings / phrases (string[])
  approvedPhrases  Json?
  /// Forbidden phrases (string[]) — soft style filter, never silent failure of safety
  forbiddenPhrases Json?
  /// Good vs bad training examples: [{ good, bad, note? }]
  examples         Json?
  /// Freeform manager coaching notes (not injected as system override for facts)
  coachingNotes    String?

  /// Points at the previous published version id when rolled back / superseded
  supersedesId String?
  publishedAt  DateTime?
  publishedBy  String?
  approvedAt   DateTime?
  approvedBy   String?
  createdBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationScope, key, version])
  @@index([tenantId, status])
  @@index([tenantId, locationId, department, status])
