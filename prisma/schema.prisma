/// One valuation event for a trade. The four kinds are never conflated:
///   MARKET_ESTIMATE      — licensed market data (e.g. MMR/KBB/Black Book) — NOT an offer
///   PRELIMINARY_ESTIMATE — provider/dealer estimate before inspection — NOT an offer
///   DEALER_APPRAISAL     — staff appraisal after review/inspection
///   FINAL_OFFER          — manager-approved offer with an expiry
/// A dollar figure reaches the customer only when displayPermitted (provider license and
/// dealership rules allow it) and the row is ACTIVE and unexpired.
model TradeAppraisal {
  id String @id @default(cuid())

  tenantId       String
  tradeRequestId String
  tradeRequest   TradeRequest @relation(fields: [tradeRequestId], references: [id], onDelete: Cascade)

