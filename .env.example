# Server-only — never expose these via VITE_/NEXT_PUBLIC_ prefixes

# Runtime
NODE_ENV=development
# Which DEPLOYMENT this is: production | staging | development | test (docs/deployment/DEPLOYMENT_TIER.md).
# Leave unset to derive it from NODE_ENV (production => production tier), exactly as before.
# Hosted staging runs NODE_ENV=production with DEPLOYMENT_TIER=staging: sandbox lead delivery and
# the sandbox scheduler may run for SANDBOX routes / flagged test tenants only; live sending is
# impossible. DEPLOYMENT_TIER=production requires NODE_ENV=production (boot fails otherwise).
# DEPLOYMENT_TIER=
PORT=3000

# PostgreSQL (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/amqur?schema=public

# JWT (required) — JWT_SECRET must be >= 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Short-lived access tokens (staff)
JWT_EXPIRES_IN=15m
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=7d
# Widget JWT lifetime (minted by /api/public/widget-token)
WIDGET_TOKEN_EXPIRES_IN=4h
# Concurrent open chat streams per client IP / per bearer token (429 above the cap).
CHAT_STREAM_MAX_CONCURRENT_PER_IP=10
CHAT_STREAM_MAX_CONCURRENT_PER_TOKEN=4

# CORS — comma-separated origins for production (required in production)
# Leave empty in development to reflect request origin
CORS_ORIGINS=https://dealer.example.com,https://www.dealer.example.com

# One-time bootstrap of first tenant + SUPER_ADMIN via POST /api/auth/bootstrap
# Leave empty to disable bootstrap endpoint
BOOTSTRAP_SECRET=

# Anthropic Claude (optional — polish + intelligent Q&A disabled when empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_MS=25000

# OpenAI (optional fallback LLM — disabled when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=25000

# CRM outbound webhook (optional — leads/handoff events)
CRM_WEBHOOK_URL=

# Inventory feed sync cron (every 30m when true)
INVENTORY_SYNC_ENABLED=false
# Comma-separated hostnames allowed for feed fetches (SSRF protection). Empty = any public host (still blocks private IPs).
INVENTORY_FEED_ALLOWED_HOSTS=

# Google Calendar (optional — implemented but not required for chat appointment preference capture)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Integration secret vault (32+ chars) — required before storing Tekion/vAuto credentials
INTEGRATION_ENCRYPTION_KEY=

# Tekion (placeholders only — live disabled until partner credentials + official API docs)
# TEKION_API_BASE_URL=
# TEKION_CLIENT_ID=
# TEKION_CLIENT_SECRET=
# TEKION_WEBHOOK_SECRET=
# TEKION_DEALER_GROUP_ID=
# TEKION_API_VERSION=

# vAuto feed (use Location.inventoryFeedUrl + inventoryFeedType in DB; transport is authorized feed download)
# VAUTO_FEED_TRANSPORT=HTTPS
# VAUTO_EXPECTED_MIN_RECORDS=1
# VAUTO_FRESHNESS_HOURS=24

# Optional Redis (widget-config cache). Outage degrades cache only — never blocks readiness.
REDIS_URL=

# Outbox processor (API process cron). Set false on API replicas when a worker owns processing.
OUTBOX_PROCESSOR_ENABLED=true
OUTBOX_POLL_MS=15000
PROCESS_ROLE=all

# Knowledge embeddings (OFF by default; also needs OPENAI_API_KEY)
KNOWLEDGE_EMBEDDINGS_ENABLED=false
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_PGVECTOR_ENABLED=false

# Tool registry (Phase 4). Both OFF by default; providers are mocks only.
TOOL_REGISTRY_ENABLED=false
TOOL_DISPATCH_ENABLED=false

# Per-rooftop ADF/XML lead delivery (docs/ADF_LEAD_DELIVERY.md). Everything is fail-closed.
# Master switch: false = nothing is ever handed to a transport.
ADF_SEND_ENABLED=false
# sandbox | live. `live` only takes effect in the production deployment tier + ADF_SEND_ENABLED=true +
# a verified, production-enabled PRODUCTION route. Leave as sandbox.
LEAD_DELIVERY_MODE=sandbox
# Sandbox transport: sink (in-process) | smtp (loopback mock SMTP only).
ADF_SANDBOX_TRANSPORT=sink
ADF_SMTP_HOST=127.0.0.1
ADF_SMTP_PORT=11025
ADF_SMTP_SECURE=false
# ADF_SMTP_USER=
# ADF_SMTP_PASS=
ADF_FROM_ADDRESS=adf-sandbox@amqur.example.invalid
# Hard overall deadline for one lead hand-off, ms (250-60000). The 90 s stale-SENT window always
# exceeds it by 30 s, so a slow send is never re-sent by a second worker.
ADF_SEND_DEADLINE_MS=30000
ADF_PROVIDER_NAME=AMQUR AI
ADF_MAX_BYTES=65536
# ADF_SANDBOX_SINK_DIR=

# SANDBOX (demo) scheduler — explicit opt-in, default off. Needs a non-production deployment tier
# (hard refusal; `true` in the production tier fails env validation), this switch, the tenant/location
# `sandboxScheduler` flag AND an enabled + liveReady MOCK `appointments` connection.
SANDBOX_SCHEDULER_ENABLED=false

# POST /chat/stream: interval of the SSE comment heartbeat (": hb") while a turn runs, ms.
CHAT_STREAM_HEARTBEAT_MS=15000
