  /// Provider id (e.g. "staff", "vauto", "manheim_mmr") — "staff" for human appraisals
  provider         String
  providerRef      String?
  amount           Float?
  amountLow        Float?
  amountHigh       Float?
  displayPermitted Boolean   @default(false)
  /// ACTIVE | SUPERSEDED | EXPIRED | ACCEPTED | DECLINED | COUNTERED
  status           String    @default("ACTIVE")
  counterAmount    Float?
  conditionBasis   String?
  notes            String?
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  expiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, tradeRequestId])
  @@index([tenantId, status])
}

